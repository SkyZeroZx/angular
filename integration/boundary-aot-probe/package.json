{
  "name": "angular-boundary-aot-probe",
  "private": true,
  "type": "module",
  "scripts": {
    "aot": "ngc -p tsconfig.json",
    "bundle": "esbuild out/main.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/main.js",
    "build": "rm -rf out dist && mkdir -p dist && npm run aot && npm run bundle && cp src/index.html dist/index.html",
    "e2e": "node e2e.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0-next.7",
    "@angular/compiler": "22.2.0-next.7",
    "@angular/compiler-cli": "22.2.0-next.7",
    "@angular/core": "22.2.0-next.7",
    "@angular/platform-browser": "22.2.0-next.7",
    "esbuild": "0.25.9",
    "puppeteer": "24.16.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  }
}
