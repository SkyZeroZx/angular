{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true,
    "enableI18nLegacyMessageIdFormat": false
  },
  "include": ["src/**/*.ts"]
}
